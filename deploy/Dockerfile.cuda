# syntax=docker/dockerfile:1
# yovoice 网页版 CUDA 镜像：内置 CUDA 12.8 推理内核，容器启动后直接用显卡。
# 构建：docker build -f deploy/Dockerfile.cuda -t yovoice:cu128 .
# 运行：
#   docker run -d --gpus all --name yovoice -p 8080:8080 \
#     -e YOVOICE_WEB_TOKEN="$(openssl rand -hex 32)" \
#     -v yovoice-data:/data yovoice:cu128
# 宿主机需要 NVIDIA 驱动与 nvidia-container-toolkit，驱动要支持 CUDA 12.8。
# 想让镜像用系统里的 CUDA 运行库（省下约 800 MB），构建时加 --build-arg WITH_CUDART=0。

ARG CUDA_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04
ARG NODE_IMAGE=node:22-bookworm-slim
ARG GO_IMAGE=golang:1.26-bookworm

# 第一阶段：构建网页版前端。界面直接引用 internal/ 下的模型目录等数据，所以要一并复制。
FROM ${NODE_IMAGE} AS web
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml ./
COPY web/patches ./patches
RUN corepack enable && corepack prepare pnpm@9.15.2 --activate \
    && pnpm install --frozen-lockfile
COPY web/src ./src
COPY web/public ./public
COPY web/index.html web/tsconfig.json web/vite.config.ts ./
COPY internal/ /src/internal/
RUN pnpm run build

# 第二阶段：编译服务端与随包转换器。
FROM ${GO_IMAGE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make gcc curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/ cmd/
COPY internal/ internal/
COPY scripts/ scripts/
RUN python3 scripts/build-ffmpeg.py artifacts/tools \
    && go build -trimpath -ldflags "-s -w" -o /out/yovoice ./cmd/yovoice \
    && cp -r artifacts/tools /out/tools

# 第三阶段：运行镜像，内核来自 upstream audio.cpp 的 CUDA 12.8 构建。
FROM ${CUDA_IMAGE}
ARG ENGINE_VERSION=v0.9.3
ARG WITH_CUDART=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/yovoice /usr/local/bin/yovoice
COPY --from=builder /out/tools /usr/local/bin/tools
COPY --from=web /src/web/dist /opt/yovoice/web
# 内核与 CUDA 运行库都平铺在与可执行文件同级，引擎按 rpath 就地加载。
RUN set -eux; \
    mkdir -p /opt/yovoice/engine; \
    curl -fsSL -o /tmp/engine.tar.gz "https://github.com/0xShug0/audio.cpp/releases/download/${ENGINE_VERSION}/audio-${ENGINE_VERSION}-bin-ubuntu-x64-cuda12.8-colab.tar.gz"; \
    if [ "$WITH_CUDART" = "1" ]; then \
      curl -fsSL -o /tmp/cudart.tar.gz "https://github.com/0xShug0/audio.cpp/releases/download/${ENGINE_VERSION}/audio-${ENGINE_VERSION}-cudart-ubuntu-x64-cuda12.8.tar.gz"; \
      tar xzf /tmp/cudart.tar.gz -C /opt/yovoice/engine; \
    fi; \
    tar xzf /tmp/engine.tar.gz -C /opt/yovoice/engine; \
    rm -f /tmp/engine.tar.gz /tmp/cudart.tar.gz; \
    chmod +x /opt/yovoice/engine/audiocpp_server; \
    printf '{"version":"%s","backend":"cuda"}\n' "${ENGINE_VERSION}" > /opt/yovoice/engine/yovoice-engine.json
ENV YOVOICE_WEB_DIR=/opt/yovoice/web
ENV WORKBENCH_ENGINE=/opt/yovoice/engine/audiocpp_server
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["yovoice"]
CMD ["web", "--data-dir", "/data", "--listen", "0.0.0.0:8080", "--web-dir", "/opt/yovoice/web"]
